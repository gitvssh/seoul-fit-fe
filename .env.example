# Seoul Fit Frontend environment variables
#
# Keep this file empty of real credentials. NEXT_PUBLIC_* values are embedded in
# browser assets during `next build`; changing them requires rebuilding the image.

# Build time: public application origin, used to derive the OAuth callback by default.
NEXT_PUBLIC_APP_URL=

# Build time: browser-to-backend URL, including OAuth and authenticated API calls.
NEXT_PUBLIC_BACKEND_URL=

# Build time: Kakao OAuth and map browser credentials/configuration.
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_MAP_API_KEY=

# Build time: optional override; defaults to NEXT_PUBLIC_APP_URL/auth/callback.
NEXT_PUBLIC_KAKAO_REDIRECT_URI=

# Build time: browser-visible OpenWeather key used by the current weather client.
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# Runtime: server-only backend URL for Route Handlers/SSR (for example, a k8s Service URL).
BACKEND_INTERNAL_URL=

# Runtime: server-only Seoul Open Data API key.
SEOUL_API_KEY=

# NODE_ENV and NEXT_RUNTIME are managed by Next.js and must not be set here.
